# Copy this file to `.env` and fill the values. Do NOT commit your real API key.
# Example:
# OPENAI_API_KEY=sk-xxx
# COACH_API_SECRET=some-long-secret

PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
ALLOWED_ORIGINS=http://localhost:8000
# Optional: set a shared secret that the client must send as header `x-api-secret`
COACH_API_SECRET=
# Max tokens or limits
MAX_RESPONSE_TOKENS=800
# Rate limit: requests per window (see README)
RATE_WINDOW_MS=60000
RATE_MAX=60
